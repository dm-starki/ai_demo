# =============================================================================
# Пример переменных окружения фронтенда (продакшен, Vite: только VITE_*).
# Скопируйте в .env.production при сборке или задайте в CI.
# =============================================================================

# Порт локальной разработки (также можно переопределить для preview)
VITE_DEV_PORT=5101

# Базовый URL REST API (Fastify), без завершающего слэша
VITE_API_URL=https://api.your-domain.example

# URL сервера Socket.IO, без завершающего слэша
VITE_SOCKET_URL=https://ws.your-domain.example
