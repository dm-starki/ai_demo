# =============================================================================
# Пример переменных окружения бэкенда (продакшен).
# Скопируйте в .env на сервере и заполните реальными значениями.
# Никогда не коммитьте файл .env с секретами в репозиторий.
# =============================================================================

# -----------------------------------------------------------------------------
# HTTP API (Fastify)
# -----------------------------------------------------------------------------
# Порт REST API
HTTP_PORT=5102

# Разрешённый origin фронтенда для CORS (точный URL, например https://chat.example.com)
CORS_ORIGIN=https://your-frontend.example.com

# -----------------------------------------------------------------------------
# WebSocket (Socket.IO) — отдельный порт
# -----------------------------------------------------------------------------
SOCKET_PORT=5103

# -----------------------------------------------------------------------------
# PostgreSQL — строка подключения приложения (роль chat_cursor_auto)
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://chat_cursor_auto:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/chat_cursor_auto

# -----------------------------------------------------------------------------
# JWT — секреты подписи (обязательно длинные случайные строки в продакшене)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_LONG_RANDOM_REFRESH_SECRET

# Время жизни access-токена (например 15m, 900s)
JWT_ACCESS_EXPIRES=15m

# Максимальная длительность «скользящей» сессии по refresh (7 дней)
JWT_REFRESH_MAX=7d
