# ============================================================
# Конфигурация фронтенда — ПРОДУКТИВ
# Заполните URL вашего продуктивного сервера!
# ============================================================

# --- API ---
# Базовый URL HTTP API бэкенда (укажите реальный домен/IP)
VITE_API_URL=https://your-domain.com

# --- WebSocket ---
# URL WebSocket сервера (socket.io)
VITE_SOCKET_URL=https://your-domain.com

# --- Приложение ---
# Название приложения
VITE_APP_NAME=Chat

# Режим работы: development | production
VITE_NODE_ENV=production
