{
  "name": "back",
  "version": "1.0.0",
  "description": "Серверная часть чата — Fastify + socket.io + PostgreSQL",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && echo 'Бэкенд собран'",
    "start": "node build/index.js",
    "db:init": "tsx src/db/initDb.ts",
    "clean": "rm -rf build node_modules && echo 'Бэкенд очищен'",
    "stop": "pkill -f 'node build/index.js' || pkill -f 'tsx src/index.ts' || true"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^9.0.8",
    "@types/jsonwebtoken": "^9.0.6",
    "tsx": "^4.9.3",
    "typescript": "^5.4.5"
  }
}
