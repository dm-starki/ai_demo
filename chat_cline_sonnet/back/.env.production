# ============================================================
# Конфигурация бэкенда — ПРОДУКТИВ
# Заполните все секреты перед деплоем!
# ============================================================

# --- Сервер ---
# Хост на котором запускается Fastify
SERVER_HOST=0.0.0.0

# Порт HTTP API (Fastify)
API_PORT=5202

# Порт WebSocket (socket.io)
SOCKET_PORT=5203

# Режим работы: development | production
NODE_ENV=production

# --- База данных PostgreSQL ---
# Хост PostgreSQL сервера
DB_HOST=localhost

# Порт PostgreSQL
DB_PORT=5432

# Имя базы данных проекта
DB_NAME=chat_cline_sonnet

# Пользователь БД проекта
DB_USER=chat_cline_sonnet

# Пароль пользователя БД (ОБЯЗАТЕЛЬНО задайте стойкий пароль!)
DB_PASSWORD=CHANGE_THIS_PASSWORD

# Максимальное количество соединений в пуле
DB_POOL_MAX=20

# --- JWT токены ---
# Секретный ключ для подписи access токенов (минимум 32 символа, случайная строка)
JWT_ACCESS_SECRET=CHANGE_THIS_ACCESS_SECRET_MIN_32_CHARS_RANDOM

# Секретный ключ для подписи refresh токенов (минимум 32 символа, случайная строка)
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_MIN_32_CHARS_RANDOM

# Время жизни access токена (1 час)
JWT_ACCESS_EXPIRES_IN=1h

# Время жизни refresh токена (7 дней)
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Разрешённые origins для CORS (укажите домен вашего фронтенда)
CORS_ORIGINS=https://your-domain.com

# --- Bcrypt ---
# Количество раундов хэширования паролей (в проде рекомендуется 12)
BCRYPT_ROUNDS=12
