# =============================================================================
# Конфигурация бэкенда — пример для продакшена
# Проект: AI Chat
# =============================================================================
# ИНСТРУКЦИЯ: Скопируйте этот файл в .env и заполните значения.
# НЕ храните .env в системе контроля версий!
# =============================================================================

# --- Сервер ---
# Хост для прослушивания HTTP-запросов
HOST=0.0.0.0
# Порт REST API сервера
PORT=3402
# Среда выполнения: development | production
NODE_ENV=production

# --- Socket.io ---
# Порт для WebSocket сервера (отдельный от REST)
SOCKET_PORT=3403

# --- База данных PostgreSQL ---
# Хост сервера PostgreSQL
DB_HOST=localhost
# Порт PostgreSQL (стандартный 5432)
DB_PORT=5432
# Имя базы данных
DB_NAME=cursor_sonnet
# Пользователь БД
DB_USER=cursor_sonnet
# Пароль пользователя БД (ЗАМЕНИТЕ на надёжный пароль!)
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Максимум соединений в пуле
DB_POOL_MAX=20

# --- JWT токены ---
# Секретный ключ для подписи access токенов (минимум 64 символа, случайные)
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_64_CHARS_ACCESS_SECRET
# Секретный ключ для подписи refresh токенов (минимум 64 символа, случайные)
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_64_CHARS_REFRESH_SECRET
# Время жизни access токена
JWT_ACCESS_EXPIRES=1h
# Время жизни refresh токена
JWT_REFRESH_EXPIRES=7d

# --- CORS ---
# Разрешённые источники (URL продакшен-фронтенда)
CORS_ORIGIN=https://your-domain.com

# --- Администратор PostgreSQL (только для db:init) ---
# Пароль суперпользователя postgres (только для первоначальной инициализации)
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD
