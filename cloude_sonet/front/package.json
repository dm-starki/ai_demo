{
  "name": "chat-frontend",
  "version": "1.0.0",
  "description": "Фронтенд чата на React + Vite + ANT Design + RTK Query",
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/.bin/vite --port 3401 --open",
    "build": "node ../node_modules/.bin/tsc -p tsconfig.json && node ../node_modules/.bin/vite build",
    "preview": "node ../node_modules/.bin/vite preview",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.7",
    "@reduxjs/toolkit": "^2.3.0",
    "antd": "^5.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.24.0",
    "socket.io-client": "^4.7.5",
    "emoji-picker-react": "^4.9.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
