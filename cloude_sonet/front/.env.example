# =============================================================================
# Конфигурация фронтенда — пример для продакшена
# Проект: AI Chat
# =============================================================================
# ИНСТРУКЦИЯ: Скопируйте в .env и заполните значения для вашего окружения.
# Все переменные с префиксом VITE_ встраиваются в сборку при build!

# --- REST API ---
# URL REST API бэкенда (для продакшена - ваш домен)
VITE_API_URL=https://api.your-domain.com
# Порт REST API
VITE_API_PORT=3402

# --- WebSocket ---
# URL WebSocket сервера (для продакшена - ваш домен)
VITE_SOCKET_URL=https://ws.your-domain.com

# --- Приложение ---
# Название приложения
VITE_APP_NAME=AI Chat
# Среда: development | production
VITE_APP_ENV=production
