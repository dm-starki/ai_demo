# =============================================================================
# Пример переменных для продакшена фронтенда (Vite).
# При сборке Vite подставляет только переменные с префиксом VITE_.
# =============================================================================

# Полный URL REST API за reverse-proxy или CDN.
VITE_API_URL=https://chat.example.com/api

# Полный URL WebSocket-сервера (тот же хост с путём прокси или отдельный поддомен).
VITE_SOCKET_URL=https://ws.chat.example.com
