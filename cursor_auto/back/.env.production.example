# =============================================================================
# Пример переменных окружения для продакшена (Ubuntu 24, Node.js).
# Скопируйте в .env на сервере и заполните реальными значениями.
# Комментарии описывают назначение каждой переменной.
# =============================================================================

# REST API слушает этот порт (за reverse-proxy или напрямую).
REST_PORT=3102

# Socket.IO на отдельном порту (проксируйте WebSocket отдельно при необходимости).
SOCKET_PORT=3103

# Разрешённый origin браузера (точный URL фронтенда, без завершающего слэша).
CORS_ORIGIN=https://chat.example.com

# Подключение к PostgreSQL от имени ограниченной роли приложения.
DATABASE_URL=postgresql://cursor_auto:STRONG_DB_PASSWORD@127.0.0.1:5432/cursor_auto

# URL администратора БД нужен только для инициализации схемы (yarn db:init на сервере).
DB_ADMIN_URL=postgresql://postgres:ADMIN_PASSWORD@127.0.0.1:5432/cursor_auto

# Секрет подписи access JWT — уникальный, длинный, не хранить в git.
JWT_ACCESS_SECRET=

# Секрет подписи refresh JWT — отличать от access; хранить отдельно.
JWT_REFRESH_SECRET=

# Срок действия access-токена (короткий), формат ms/m/h/d.
JWT_ACCESS_EXPIRES=15m

# Максимум календарного времени «цепочки» refresh с первого логина.
JWT_SESSION_MAX=7d
